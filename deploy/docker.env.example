# Copy to the project root as .env. Keep credentials out of Git.
FTP_JAXA_USER=replace_with_your_username
FTP_JAXA_PASSWORD=replace_with_your_password
# Optional: FTP_JAXA_HOST=hokusai.eorc.jaxa.jp
CONVLSTM_POLL_INTERVAL_SECONDS=300
# Set these to the output of id -u and id -g on the Docker host.
CONVLSTM_UID=
CONVLSTM_GID=
